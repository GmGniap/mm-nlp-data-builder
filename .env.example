# =============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your private values.
# .env is ignored by git to protect credentials.
# =============================================================================

# PostgreSQL (Neon Database)
NEON_DATABASE_URL="postgresql://username:password@ep-example.aws.neon.tech/neondb?sslmode=require"

# Telegram API Credentials (Optional override)
TELEGRAM_API_ID="your_telegram_api_id"
TELEGRAM_API_HASH="your_telegram_api_hash"
TELEGRAM_STRING_SESSION="your_string_session_token"

# Remote Registry / Deployment Config (used by deploy_docker.sh)
DOCKER_REGISTRY="your-registry.example.com:5005"
DOCKER_IMAGE_NAME="telegram_scraper"
DOCKER_IMAGE_TAG="v0.1"
DOCKERFILE_PATH="services/telegram_scraper/Dockerfile"
DOCKER_PLATFORM="linux/arm64"
